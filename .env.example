# ── Firebase (opzionale) ──
# Servono per attivare le SESSIONI CONDIVISE. Senza queste variabili l'app
# funziona comunque, ma solo in locale su ogni dispositivo.
#
# Come ottenerle (gratis, ~2 minuti):
# 1. Vai su https://console.firebase.google.com e crea un progetto
# 2. Crea un database Firestore (parti in "modalità test")
# 3. Aggiungi un'app Web (</>) e copia i valori del "firebaseConfig" qui sotto
# 4. Copia questo file in ".env.local" e incolla i tuoi valori
#
# NB: sono chiavi pubbliche client (prefisso NEXT_PUBLIC_): possono stare nel
# browser. La sicurezza vera si fa con le Regole di Firestore (vedi README).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
